HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
APP_URL=http://127.0.0.1:8080
# Set true behind an HTTPS reverse proxy. Configure the proxy to forward HTTPS.
SECURE_COOKIES=false
# Optional. If unset, a key is generated in DATA_DIR; include it in backups.
ENCRYPTION_KEY=
# Optional alternative to the Spotify browser-session connector (which supports Free).
# Only the developer-app connection requires an eligible Premium app owner.
SPOTIFY_CLIENT_ID=
# Must exactly match the redirect registered in the Spotify developer dashboard.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/connections/spotify/callback
